__pycache__/
*.pyc

# generator/_test_output/ holds both the test scripts (*_test.py, real source, kept
# tracked below) and their output -- every script wipes and rebuilds its own output
# folder on each run (some even recopy from a live external project), so tracking that
# output just produces diff noise (fresh timestamps/GUIDs) with no real content change.
# Ignore everything in the directory by default, then re-include the scripts themselves.
generator/_test_output/*
!generator/_test_output/*.py
